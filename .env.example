# App
APP_NAME=TPMS-FORGE
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database
POSTGRES_DB=tpms_forge
POSTGRES_USER=tpms_forge
POSTGRES_PASSWORD=tpms_forge
DATABASE_URL=postgresql+psycopg://tpms_forge:tpms_forge@postgres:5432/tpms_forge

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage
STORAGE_BACKEND=local
# Keep runtime STL/OBJ/G-code data outside this Git repository.
STORAGE_ROOT=../TPMS-FORGE-data
TPMS_STORAGE_HOST_PATH=../TPMS-FORGE-data
MAX_UPLOAD_SIZE_MB=200

# External slicer integration. Docker Compose can override these if needed.
SLICER_ENGINE=orca
ORCA_SLICER_PATH=orca-slicer
# Optional Orca profile files. Use absolute paths if your CLI needs a specific printer/process/filament.
# ORCA_MACHINE_PROFILE=
# ORCA_PROCESS_PROFILE=
# ORCA_FILAMENT_PROFILE=
# Optional when running a Windows OrcaSlicer .exe from WSL. Use a /mnt/... path.
# ORCA_WINDOWS_WORK_DIR=/mnt/e/TPMS-FORGE-slicer-cache
# Optional VSP benchmark/toolpath project path for the in-house slicer engine.
# VSP_SLICER_PATH=/mnt/d/path/to/vsp_benchmark_test2.0
PRUSA_SLICER_PATH=prusa-slicer
SLICER_TIMEOUT_SECONDS=300

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
