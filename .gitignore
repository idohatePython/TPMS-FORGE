# Local reference documents.
# Keep them on disk for reading, but never commit them.
/my_docs/
/my_docs/**

# Environment
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.pnpm-store/

# Runtime storage
storage/users/*
storage/temp/*
!storage/users/.gitkeep
!storage/temp/.gitkeep
result.json

# Local compose/database data
postgres_data/

# Lock files are committed when generated
!uv.lock
!frontend/pnpm-lock.yaml

# Logs
*.log
logs/

# Editors
.idea/
.vscode/
.DS_Store
.corepack/
